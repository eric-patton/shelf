{
  "productName": "Shelf for Windows",
  "version": "0.3.0",
  "identifier": "com.ericpatton.shelf.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/package-runner.mjs dev",
    "beforeBuildCommand": "node scripts/package-runner.mjs build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "7ef88bb7-6239-432c-a7f3-91ec0d158583"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Shelf for Windows",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  }
}
